; Engine configuration file. Godot 4.7

config_version=5

[application]

config/name="UNTITLED — Черкассы (прототип)"
config/description="Серый прототип: весь город, герой от первого лица, часы, день и ночь."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

InputSetup="*res://autoload/input_setup.gd"
GameClock="*res://autoload/game_clock.gd"
CityData="*res://autoload/city_data.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
